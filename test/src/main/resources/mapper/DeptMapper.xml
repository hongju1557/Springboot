<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.biz.test.mapper.DeptMapper">

    <select id="findAll"
            resultType="com.biz.test.dto.Dept">

        SELECT
            DEPT_ID AS deptId,
            DEPT_TITLE AS deptTitle
        FROM dept
        ORDER BY DEPT_ID

    </select>

    <!-- 해당 부서에 소속된 사원 수 -->
    <select id="countEmployees" resultType="int">
        SELECT COUNT(*)
        FROM emp
        WHERE DEPT_ID = #{deptId}
    </select>

    <!-- 부서 삭제 -->
    <delete id="delete">
        DELETE FROM dept
        WHERE DEPT_ID = #{deptId}
    </delete>

    <insert id="save" parameterType="com.biz.test.dto.Dept">
        INSERT INTO dept (
            DEPT_ID,
            DEPT_TITLE,
            LOCATION_ID
        )
        VALUES (
            #{deptId},
            #{deptTitle},
            #{locationId}
        )
    </insert>

</mapper>